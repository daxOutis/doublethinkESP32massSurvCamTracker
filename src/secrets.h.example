// Copy this file to secrets.h (same folder) and fill in your own values.
// secrets.h is gitignored on purpose — it never gets committed, so your
// AP credentials stay local to your machine.

// Doublethink hosts its own WiFi access point (no home WiFi/internet
// needed) so you can connect to it in the field to update the
// danger-zone list. Password must be 8+ characters or the ESP32's
// softAP() silently rejects it and falls back to an open network.
#define AP_SSID "ChangeMe"
#define AP_PASSWORD "ChangeMe123"
